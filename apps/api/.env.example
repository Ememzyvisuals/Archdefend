# ===================================================
# ArchDefend API - Environment Variables
# ===================================================
# Copy this file to .env and fill in all values.
# Never commit .env to version control.
# ===================================================

# Application
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=YOUR_SECRET_KEY_MIN_32_CHARS_RANDOM_STRING
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,https://archdefend.vercel.app
PYTHON_VERSION=3.12

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cache / Queue (Upstash Redis)
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379

# Authentication
JWT_SECRET=YOUR_JWT_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# GitHub OAuth App
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_APP_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_APP_CLIENT_SECRET
GITHUB_CALLBACK_URL=https://YOUR_RENDER_URL/api/auth/github/callback

# AI Providers
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Payments (NOWPayments)
NOWPAYMENTS_API_KEY=YOUR_NOWPAYMENTS_API_KEY
NOWPAYMENTS_IPN_SECRET=YOUR_NOWPAYMENTS_IPN_SECRET

# Repository Analysis
TEMP_CLONE_DIR=/tmp/archdefend_clones
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=300

# Credit Costs
FREE_TIER_CREDITS=100
SMALL_REPO_CREDITS=10
MEDIUM_REPO_CREDITS=25
LARGE_REPO_CREDITS=50
SECURITY_SCAN_CREDITS=5
PPTX_EXPORT_CREDITS=3
